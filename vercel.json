{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "evidence": {
      "root": "services/evidence",
      "entrypoint": "src/server.ts"
    },
    "relayer": {
      "root": "services/relayer",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/evidence(/.*)?",
      "destination": {
        "type": "service",
        "service": "evidence"
      }
    },
    {
      "source": "/api/relayer(/.*)?",
      "destination": {
        "type": "service",
        "service": "relayer"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
